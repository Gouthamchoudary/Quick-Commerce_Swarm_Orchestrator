# Default: deterministic parser with no external provider or API key required.
ORDER_PARSER_PROVIDER=local

# Recommended hosted option for a lightweight development machine.
ORDER_PARSER_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# Optional local Ollama setup.
# ORDER_PARSER_PROVIDER=ollama
# OLLAMA_MODEL=llama3.2
# OLLAMA_BASE_URL=http://localhost:11434
